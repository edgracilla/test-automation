# Copy to .env (shared values) and .env.<name> (per environment, e.g. .env.dev, .env.staging).
# Choose the environment with TEST_ENV=<name>; .env.<name> wins over .env, the shell wins over both.

# TEST_ENV=dev

API_URL=https://api.example.com

# Credentials read by auth profiles in config/test.config.js
# API_TOKEN=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Print every request and response status
# LOG_HTTP=1
